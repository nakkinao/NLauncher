<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:alertDialogTheme">@style/Theme.NLauncher.Dialog</item>
    </style>

    <style name="Theme.NLauncher.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF8AB4F8</item>
    </style>

    <style name="Theme.NLauncher.Picker" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF8AB4F8</item>
        <item name="android:windowBackground">#FF121216</item>
        <item name="android:statusBarColor">#FF121216</item>
        <item name="android:navigationBarColor">#FF121216</item>
    </style>
</resources>
